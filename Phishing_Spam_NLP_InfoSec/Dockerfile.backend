FROM python:3.11-slim

WORKDIR /app

# Step 1: Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Step 2: Download NLTK datasets for email NLP cleaning
RUN python -m nltk.downloader stopwords punkt punkt_tab

# Step 3: Copy only necessary backend code and ML models
COPY server.py .
COPY src/ ./src/
COPY models/ ./models/

# Step 4: Expose FastAPI port and start server
EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
